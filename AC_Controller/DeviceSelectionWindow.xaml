<Window x:Class="AC_Controller.DeviceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar aparelho · AC Controller"
        Width="608" Height="560" MinWidth="376" MinHeight="342"
        WindowStartupLocation="CenterScreen" ContentRendered="OnContentRendered"
        Background="#F5F7F7" Foreground="#132D3A" FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14" Language="pt-BR" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#47626B"/>
        <SolidColorBrush x:Key="Accent" Color="#007568"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Foreground" Value="#132D3A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9FB1B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="Transparent"
                                    Margin="2" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.89"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="1"/>
                                <Setter TargetName="Surface" Property="Background" Value="#E5EBEB"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D7DFDF"/>
                                <Setter Property="Foreground" Value="#5A6D70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,4,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="White" BorderBrush="#B9C8CA" BorderThickness="1"
                                CornerRadius="9" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Width="19" Height="19" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Indicator" Fill="White" Stroke="#83999D" StrokeThickness="1.5"/>
                                    <Path x:Name="Tick" Visibility="Collapsed" Data="M 4,9 L 7.5,12.5 L 14,6"
                                          Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EDF4F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E4F3EF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Surface" Property="Padding" Value="13,11"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#132D3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="26,24,26,17">
            <TextBlock Text="Selecionar aparelho" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Escolha o ar-condicionado que deseja controlar."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="26,0,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ResultsLabel" Margin="0,0,0,9" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ListBox x:Name="DeviceList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" TextSearch.TextPath="Name"
                     ItemContainerStyle="{StaticResource DeviceItem}" AutomationProperties.Name="Aparelhos disponíveis"
                     PreviewKeyDown="OnDeviceKeyDown" MouseDoubleClick="OnDeviceDoubleClick">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="#132D3A"/>
                            <TextBlock Text="{Binding Model}" Margin="0,1,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,0,16,1" FontSize="12" Foreground="{StaticResource Muted}">
                                    <Run Text="IP" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Ip, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                                    <Run Text="MAC" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Mac, Mode=OneWay}"/>
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="EmptyState" Grid.RowSpan="2" Margin="0,0,4,8" Padding="17" Background="White"
                    CornerRadius="9" BorderThickness="1" BorderBrush="#C7D3D3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Nenhum aparelho encontrado" FontWeight="SemiBold" FontSize="17"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Confira se o computador e o ar-condicionado estão na mesma rede."
                               Margin="0,6,0,0" MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D6DFDF" BorderThickness="0,1,0,0" Padding="26,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Style="{StaticResource ActionButton}"/>
                <Button x:Name="ConnectButton" Margin="9,0,0,0" Content="Conectar" IsDefault="True" Click="ConfirmSelection">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=DeviceList}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
