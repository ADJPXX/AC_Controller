<Window x:Class="AC_Controller.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC_Controller"
        Title="AC Controller" Width="1024" Height="750" MinWidth="350" MinHeight="390"
        WindowStartupLocation="CenterScreen" Background="#F4F7F6" Foreground="#132D3A"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Background="#F4F7F6">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8E2DE" BorderThickness="0,0,0,1">
            <Grid x:Name="Header" Height="64" Margin="28,0" MaxWidth="1180">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#006E61" CornerRadius="10">
                        <Viewbox Margin="8">
                            <Path Data="M1,7 H12 C18,7 18,1 14,1 C12,1 11,2 11,3 M1,12 H20 C26,12 26,5 22,5 C20,5 19,6 19,7 M3,17 H14 C19,17 19,23 15,23 C13,23 12,22 12,21"
                                  Stroke="#F3FFF8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="Brand" Text="AC Controller" Margin="10,0,0,0" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ConnectionPill" Background="#E7F5EF" CornerRadius="20" Padding="10,5" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#008269" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionLabel" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" Foreground="#006754"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ChooseButton" Style="{StaticResource PanelButton}" Click="ChooseClick"
                            AutomationProperties.Name="Selecionar aparelho" ToolTip="Selecionar aparelho na rede local">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,4 H15 M11,0 L15,4 11,8 M15,12 H0 M4,8 L0,12 4,16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChooseLabel" Text="Selecionar aparelho" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <Grid x:Name="ContentArea" MaxWidth="1180" Margin="28,22,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Hero" Height="196">
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush ImageSource="Resources/climate-room.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#BC102F30" Offset="0"/>
                                <GradientStop x:Name="ShadeMiddle" Color="#A4102F30" Offset=".32"/>
                                <GradientStop x:Name="ShadeEdge" Color="#20102F30" Offset=".59"/>
                                <GradientStop Color="#00102F30" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel x:Name="HeroText" Margin="26,12" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroKicker" FontSize="12" FontWeight="SemiBold" Foreground="#B3DAD0"/>
                        <TextBlock x:Name="DeviceTitle" FontSize="36" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" Margin="-1,2,0,1"/>
                        <TextBlock x:Name="DeviceDetail" Foreground="#E0EEE9" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="HeroAction" HorizontalAlignment="Left" MinHeight="33" Margin="0,14,0,0" Padding="12,6"
                                BorderBrush="Transparent" Background="#E7F5ED" Foreground="#114A40"
                                Style="{StaticResource PanelButton}" Click="HeroClick">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Path x:Name="HeroIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock x:Name="HeroActionText" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="Notice" Grid.Row="1" CornerRadius="8" Background="#FFF1D8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#684A12" FontSize="13"
                               AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <Grid x:Name="Controls" Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TempColumn" Width="36*"/><ColumnDefinition x:Name="ControlGap" Width="16"/><ColumnDefinition x:Name="OptionsColumn" Width="64*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="TempCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Temperatura alvo" Style="{StaticResource SectionTitle}"/>
                            <local:TemperatureDial x:Name="Dial" Grid.Row="1" Height="181" Margin="0,9,0,6" VerticalAlignment="Center"/>
                            <UniformGrid Grid.Row="2" Columns="2">
                                <Button x:Name="LowerButton" Style="{StaticResource PanelButton}" Margin="0,0,4,0" Padding="3,7"
                                        AutomationProperties.Name="Diminuir temperatura em um grau" ToolTip="Diminuir 1 °C" Click="LowerClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="−" FontSize="17" LineHeight="17" LineStackingStrategy="BlockLineHeight" Margin="0,0,5,0"/>
                                        <TextBlock Text="Diminuir"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RaiseButton" Style="{StaticResource PanelButton}" Margin="4,0,0,0" Padding="3,7"
                                        AutomationProperties.Name="Aumentar temperatura em um grau" ToolTip="Aumentar 1 °C" Click="RaiseClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="17" LineHeight="17" LineStackingStrategy="BlockLineHeight" Margin="0,0,5,0"/>
                                        <TextBlock Text="Aumentar"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>
                    <Border x:Name="OptionsCard" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Climatização" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Modo de operação" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <UniformGrid x:Name="Modes" Columns="5" Rows="1" Margin="-2,0"/>
                            <Border Height="1" Background="#E1E9E5" Margin="0,17,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                        <Path Data="M2,8 H12 C17,8 17,2 13,2 C11,2 10,3 10,4 M2,12 H19 C24,12 24,6 21,6 M4,16 H14 C19,16 19,22 15,22"
                                              Stroke="#4C7871" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Ventilação" Style="{StaticResource FieldLabel}"/>
                                </StackPanel>
                                <ComboBox x:Name="FanField" Grid.Column="1" Width="156" Style="{StaticResource OptionField}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="Velocidade da ventilação" SelectionChanged="FanChanged"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                        <Path Data="M2,3 H21 V7 H2 Z M5,11 L3,15 M11,11 L8,18 M17,11 L14,18"
                                              Stroke="#4C7871" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Aletas" Style="{StaticResource FieldLabel}"/>
                                </StackPanel>
                                <ComboBox x:Name="SwingField" Grid.Column="1" Width="156" Style="{StaticResource OptionField}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="Direção das aletas" SelectionChanged="SwingChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="Freshness" Grid.Row="3" Margin="2,12,0,0" TextWrapping="Wrap"
                           Foreground="#536D68" FontSize="12" HorizontalAlignment="Left"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
